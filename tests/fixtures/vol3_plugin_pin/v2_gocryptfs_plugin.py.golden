_COLUMNS = [
    ("KeyOffset", format_hints.Hex),
    ("KeyHex", str),
    ("KeyEntropy", float),
    ("KeyLength", int),
    ("PatternOffset", format_hints.Hex),
    ("StaticRatio", float),
    ("Proven", str),
    ("Detail", str),
    # Where the row's key was read: ``process:<pid>`` (a --pid process layer),
    # ``msl:<pid>`` (a .msl slice; ``msl:?`` without a recorded pid) or
    # ``physical`` (the whole physical layer). Last, so readers by position
    # of the first eight columns are unaffected.
    ("Scope", str),
]

#: Unproven rows printed when nothing was proven and --show-unverified is off.
UNPROVEN_PREVIEW_ROWS = 8
#: Offsets reported per unique candidate (a key often sits at several places).
MAX_OFFSETS_PER_CANDIDATE = 16
#: Hard ceiling on printed rows, whatever the flags.
MAX_ROWS = 4096
#: Candidates whose Shannon entropy (bits/byte) is below this never reach the
#: oracle: a real key is random. They are reported as rejected by the prefilter.
PREFILTER_MIN_ENTROPY = 3.0
IMPLEMENTED_LOCATORS = ("anchor_regex", "entropy")
#: Bounds on reading an --oracle-sample DIRECTORY (a vault, not a filesystem).
SAMPLE_DIR_MAX_DEPTH = 3
SAMPLE_DIR_MAX_FILES = 10000
#: The entropy candidate cap grows with the bytes actually scanned: one
#: candidate per this many bytes, never below the recipe's ``max_candidates``
#: and never above ENTROPY_MAX_SCALED_CAP.
ENTROPY_BYTES_PER_CANDIDATE = 4096
ENTROPY_MAX_SCALED_CAP = 4000000
ERROR_CODE_MAX = 32
#: ``oracle.backend`` of the slow, always-available tier (see "Crypto backend").
PURE_PYTHON_BACKEND = "pure-python"
#: Seconds of oracle verification per run when --oracle-budget is not given.
DEFAULT_ORACLE_BUDGET_S = 120.0
#: COST_US is measured on an accelerated backend; pure Python is about this much slower.
PURE_PYTHON_COST_FACTOR = 20


def error_code(detail):
    """``error:<slug>`` from a verdict detail: whole words, at most ERROR_CODE_MAX chars."""
    words = re.findall(r"[a-z0-9]+", str(detail).split(";")[0].lower())
    slug = ""
    for word in words:
        candidate = word if not slug else slug + "-" + word
        if len(candidate) > ERROR_CODE_MAX:
            break
        slug = candidate
    return "error:%s" % (slug or "oracle")


def parse_oracle_params(items):
    """``["cipher=aes-gcm", "hkdf=false", "nonce_length=12"]`` -> a params dict."""
    params = {}
    for item in items or []:
        if "=" not in item:
            raise ValueError("--oracle-param %r is not key=value" % (item,))
        key, value = item.split("=", 1)
        lowered = value.strip().lower()
        if lowered in ("true", "false"):
            params[key.strip()] = lowered == "true"
        elif lowered in ("none", "null"):
            params[key.strip()] = None
        elif re.match(r"^-?[0-9]+$", lowered):
            params[key.strip()] = int(lowered)
        else:
            params[key.strip()] = value.strip()
    return params


def parse_oracle_budget(value):
    """Seconds from ``--oracle-budget`` (``None`` = unlimited); raises ValueError if not a number."""
    if value is None or str(value).strip() == "":
        return DEFAULT_ORACLE_BUDGET_S
    budget = float(value)
    if math.isnan(budget):
        raise ValueError("--oracle-budget %r is not a number of seconds" % (value,))
    return None if budget <= 0 or math.isinf(budget) else budget


def check_sample_dir(path):
    """Refuse a directory too deep or too big to be one artefact (bounded walk)."""
    base = os.path.abspath(path)
    files = 0
    for root, _dirs, names in os.walk(base):
        depth = 0 if root == base else os.path.relpath(root, base).count(os.sep) + 1
        if depth > SAMPLE_DIR_MAX_DEPTH:
            raise ValueError("--oracle-sample is deeper than %d levels; point it at the "
                             "artefact directory itself (%s)" % (SAMPLE_DIR_MAX_DEPTH, path))
        files += len(names)
        if files > SAMPLE_DIR_MAX_FILES:
            raise ValueError("--oracle-sample holds over %d files; point it at the "
                             "artefact directory itself (%s)" % (SAMPLE_DIR_MAX_FILES, path))


def shannon_entropy(data):
    """Shannon entropy of ``data`` in bits per byte."""
    if not data:
        return 0.0
    counts = {}
    for value in data:
        counts[value] = counts.get(value, 0) + 1
    total = float(len(data))
    return -sum((c / total) * math.log2(c / total) for c in counts.values())


def wildcard_to_regex(tokens):
    """``"aa ?? bb"`` -> a bytes regex; runs of ``??`` become ``.{n}``."""
    parts, wild = [], 0
    for token in tokens.split():
        if token == "??":
            wild += 1
            continue
        if wild:
            parts.append(b".{%d}" % wild)
            wild = 0
        parts.append(re.escape(bytes((int(token, 16),))))
    if wild:
        parts.append(b".{%d}" % wild)
    # A zero-width lookahead reports OVERLAPPING matches too (finditer would
    # skip a real match that overlaps a false one); DOTALL lets "." match \n.
    return b"(?=" + b"".join(parts) + b")"


class EntropyCapReached(Exception):
    """Raised by EntropyScanner on the chunk AFTER its cap: stops the layer read."""


class EntropyScanner(interfaces.layers.ScannerInterface):
    """Yield ``(offset, window)`` for high-entropy windows of ``window`` bytes.

    Cheap stage first: every ``block``-byte block of the chunk is flagged when
    it holds at least ``block_min_distinct`` distinct byte values; a window is
    examined only when every block lying fully inside it is flagged. Survivors
    must hold enough distinct values to reach ``threshold`` and then reach it.
    Only window starts that are multiples of ``step`` (absolute) are tried.
    """

    thread_safe = False

    def __init__(self, window, threshold, step, block=16, block_min_distinct=12,
                 max_candidates=500000):
        super().__init__()
        self.window = int(window)
        self.threshold = float(threshold)
        self.step = max(1, int(step))
        # A block must fit inside a window at any alignment, or no window passes.
        self.block = max(4, min(int(block), self.window // 2))
        self.block_min_distinct = int(block_min_distinct)
        self.min_distinct = int(math.ceil(2 ** self.threshold - 1e-9))
        self.max_candidates = int(max_candidates)
        self.examined = 0
        self.found = 0
        self.truncated = False
        self.stopped_at = None   # first address NOT covered once truncated

    def _block_flags(self, data):
        """One flag per ``block`` (from offset 0): does it hold ``block_min_distinct`` values?

        A constant page (all one byte -- images are mostly zero pages) is
        counted at C speed: none of its blocks can pass when more than one
        distinct value is required.
        """
        size, block = len(data), self.block
        page = block * max(1, 4096 // block)
        end = size - block + 1   # one past the last block start
        flags = []
        for start in range(0, end, page):
            chunk = data[start:start + page]
            if (self.block_min_distinct > 1 and len(chunk) == page
                    and chunk.count(chunk[:1]) == page):
                flags.extend([False] * (page // block))
                continue
            flags.extend(len(set(data[i:i + block])) >= self.block_min_distinct
                         for i in range(start, min(start + page, end), block))
        return flags

    def __call__(self, data, data_offset):
        if self.found >= self.max_candidates:
            self.truncated = True
            if self.stopped_at is None:
                self.stopped_at = data_offset
            # Every earlier chunk's windows were already consumed (the scan is
            # sequential for a non-thread-safe scanner); reading on is waste.
            raise EntropyCapReached()
        size, block, width = len(data), self.block, self.window
        flags = self._block_flags(data)
        last_start = min(size - width, self.chunk_size - 1)
        index = 0
        while index < len(flags):
            if not flags[index]:
                index += 1
                continue
            run_end = index
            while run_end < len(flags) and flags[run_end]:
                run_end += 1
            for offset, window in self._windows(data, data_offset, flags, index, run_end,
                                                last_start):
                yield offset, window
            index = run_end

    def _windows(self, data, data_offset, flags, run_start, run_end, last_start):
        block, width, step = self.block, self.window, self.step
        lo = max(0, run_start * block - block + 1)
        hi = min(last_start, run_end * block + block - 1 - width)
        first = lo + (-(data_offset + lo)) % step
        for start in range(first, hi + 1, step):
            full_lo = -(-start // block)
            full_hi = (start + width) // block
            if full_hi <= full_lo or not all(flags[full_lo:full_hi]):
                continue
            window = data[start:start + width]
            self.examined += 1
            if len(set(window)) < self.min_distinct:
                continue
            if shannon_entropy(window) < self.threshold:
                continue
            self.found += 1
            if self.found > self.max_candidates:
                self.truncated = True
                self.stopped_at = data_offset + start
                return
            yield data_offset + start, window


class PrimaryOrKernelLayer(requirements.TranslationLayerRequirement):
    """A mandatory layer requirement that the kernel module's layer also satisfies.

    Mandatory, so the LayerStacker runs at all (it only stacks when some
    non-optional requirement is unsatisfied); satisfied by ``kernel.layer_name``
    so the stacker may put the image under the ``kernel`` module instead,
    where the symbol automagic can turn it into a real kernel module.
    """

    def unsatisfied(self, context, config_path):
        own = interfaces.configuration.path_join(config_path, self.name)
        kernel_layer = interfaces.configuration.path_join(config_path, "kernel", "layer_name")
        if context.config.get(own, None) is None and context.config.get(kernel_layer, None):
            return {}
        return super().unsatisfied(context, config_path)


class Candidate(object):
    """One unique candidate key, the places it was found and its verdict."""

    def __init__(self, key):
        self.key = key
        self.sites = []          # (key_offset, pattern_offset, static_ratio, locator)
        self.locators = []
        self.proven = "unverified"
        self.site_scopes = {}    # key_offset -> Scope of the layer it was read from
        self.detail = ""
        self._entropy = None

    @property
    def entropy(self):
        if self._entropy is None:
            self._entropy = shannon_entropy(self.key)
        return self._entropy

    def add_site(self, key_offset, pattern_offset, static_ratio, locator):
        if locator not in self.locators:
            self.locators.append(locator)
        if len(self.sites) < MAX_OFFSETS_PER_CANDIDATE and all(
                site[0] != key_offset for site in self.sites):
            self.sites.append((key_offset, pattern_offset, static_ratio, locator))

    @property
    def is_proven(self):
        return self.proven.startswith("oracle:")


class MemDiverSynthGocryptfs(interfaces.plugins.PluginInterface):
    """Find and prove the secret described by recipe memdiver_gocryptfs_synth."""

    _required_framework_version = (2, 0, 0)
    _version = (1, 0, 0)

    @classmethod
    def get_requirements(cls) -> List[interfaces.configuration.RequirementInterface]:
        return [
            # FIRST, so the LayerStacker fills kernel.layer_name and the symbol
            # automagic can complete the module on a kernel image. OPTIONAL: a
            # .msl process slice or a flat dump has no kernel symbols.
            requirements.ModuleRequirement(
                name="kernel", description="OS kernel module (needed for --pid on a kernel image)",
                architectures=["Intel32", "Intel64"], optional=True),
            # Second, and satisfied by EITHER itself or kernel.layer_name: the CLI
            # stacker fills kernel.layer_name (first in the walk); in-process
            # callers (memdiver.engine.vol3_verify) set primary explicitly.
            PrimaryOrKernelLayer(name="primary", description="Memory layer"),
            requirements.ListRequirement(
                name="pid", element_type=int, description="Process IDs to scan",
                optional=True),
            requirements.StringRequirement(
                name="oracle_sample",
                description=("Oracle evidence: packed sample, raw artefact file, or "
                             "artefact directory (e.g. a gocryptfs cipher dir)"),
                optional=True),
            requirements.ListRequirement(
                name="oracle_param", element_type=str,
                description="Oracle parameter override key=value (repeatable)",
                optional=True),
            requirements.StringRequirement(
                name="oracle_budget",
                description=("Seconds the oracle may spend verifying candidates "
                             "(default %g; 0 = unlimited)" % DEFAULT_ORACLE_BUDGET_S),
                optional=True),
            requirements.BooleanRequirement(
                name="exhaustive", description="Run every locator even after a proof",
                optional=True, default=False),
            requirements.BooleanRequirement(
                name="show_unverified", description="Print unproven candidates too",
                optional=True, default=False),
            requirements.BooleanRequirement(
                name="export", description="Write a JSON report", optional=True,
                default=False),
            requirements.StringRequirement(
                name="export_path", description="File name of the JSON report",
                optional=True),
        ]

    # ------------------------------------------------------------------ layers

    def _lowest_layer(self, name):
        seen = {name}
        while True:
            deps = [d for d in self.context.layers[name].dependencies if d not in seen]
            if not deps:
                return name
            name = deps[0]
            seen.add(name)

    def _kernel_module(self):
        """The constructed kernel module, or ``None`` (no symbols / not a kernel image)."""
        name = self.config.get("kernel", None)
        if not name or not isinstance(name, str):
            return None
        try:
            return self.context.modules[name]
        except (KeyError, AttributeError):
            return None

    def _base_layer(self):
        """The top stacked layer: ``primary`` when set, else the kernel's layer."""
        primary = self.config.get("primary", None)
        if primary:
            return primary
        module = self._kernel_module()
        if module is not None:
            return module.layer_name
        name = self.config.get("kernel.layer_name", None)
        if name:
            return name
        raise ValueError("no memory layer was stacked; pass -f <image>")

    def _physical_layer(self, name):
        """Follow ``memory_layer`` down from a virtual layer to physical memory."""
        seen = {name}
        while True:
            memory = self.context.layers[name].config.get("memory_layer", None)
            if not memory or memory in seen or memory not in self.context.layers:
                break
            name = memory
            seen.add(name)
        layer = self.context.layers[name]
        # An ELF wrapper of a flat process dump exposes no sections: scan the file.
        if type(layer).__name__.startswith("Elf") or (
                layer.maximum_address <= layer.minimum_address):
            return self._lowest_layer(name)
        return name

    def _scope_of(self, layer_name):
        """The ``Scope`` cell for rows read from *layer_name* (see ``_COLUMNS``)."""
        return getattr(self, "_layer_scopes", {}).get(layer_name, "physical")

    def _note_scope(self, layer_name, scope):
        if not hasattr(self, "_layer_scopes"):
            self._layer_scopes = {}
        self._layer_scopes[layer_name] = scope

    @staticmethod
    def _tag_scope(candidates, scope):
        """Give every site found so far without a scope the current target's scope."""
        for candidate in candidates.values():
            for site in candidate.sites:
                candidate.site_scopes.setdefault(site[0], scope)

    def _scan_targets(self):
        """``[(layer_name, is_virtual_slice, sections|None)]``, per the module docstring."""
        base = self._base_layer()
        metadata = self.context.layers[base].metadata
        pids = self.config.get("pid", None) or []
        if metadata.get("msl"):
            slice_pid = metadata.get("pid")
            if pids and slice_pid is not None and int(slice_pid) not in pids:
                vollog.warning("--pid %s: this .msl slice holds pid %s; scanning it anyway",
                               pids, slice_pid)
            self._note_scope(base, "msl:%s" % (slice_pid if slice_pid is not None else "?"))
            return [(base, True, None)]
        if pids:
            layers = self._process_layers(pids)
            if layers:
                return [(name, True, sections) for name, sections in layers]
            vollog.warning("--pid %s could NOT be honoured (no kernel module, or no such "
                           "process); scanning the whole physical layer instead", pids)
        return [(self._physical_layer(base), False, None)]

    def _process_layers(self, pids):
        if self._kernel_module() is None:
            return []
        kernel = self.config["kernel"]
        try:
            from volatility3.plugins.linux import pslist
        except ImportError:
            return []
        names = []
        try:
            for task in pslist.PsList.list_tasks(
                    self.context, kernel, pslist.PsList.create_pid_filter(list(pids))):
                layer = task.add_process_layer()
                if layer:
                    self._note_scope(layer, "process:%d" % int(task.pid))
                    names.append((layer, self._vma_sections(task)))
        except (exceptions.SymbolError, exceptions.InvalidAddressException,
                KeyError, TypeError) as err:
            vollog.warning("linux pslist could not enumerate processes: %s", err)
        return names

    @staticmethod
    def _vma_sections(task):
        """``[(start, size)]`` of the task's VMAs, or ``None`` (scan the whole layer)."""
        try:
            sections = [(int(vma.vm_start), int(vma.vm_end - vma.vm_start))
                        for vma in task.mm.get_vma_iter()]
        except (exceptions.InvalidAddressException, AttributeError) as err:
            vollog.warning("could not list the VMAs of pid %s: %s", task.pid, err)
            return None
        return [s for s in sections if s[1] > 0] or None

    # ---------------------------------------------------------------- locators

    def _scan(self, layer_name, scanner, sections=None):
        layer = self.context.layers[layer_name]
        return layer.scan(context=self.context, scanner=scanner, sections=sections,
                          progress_callback=self._progress_callback)

    def _anchor_locator(self, layer_name, sections, params, candidates, stats):
        decoder = RECIPE["decoder"]
        key_offset = int(params.get("key_offset", decoder["key_offset"]))
        key_length = int(decoder["key_length"])
        tokens = params["pattern"]
        length = len(tokens.split())
        alignment = max(1, int(params.get("alignment", 1)))
        max_hits = int(params.get("max_hits", 4096))
        static_ratio = float(params.get("static_ratio", 0.0))
        layer = self.context.layers[layer_name]
        hits = 0
        scanner = scanners.RegExScanner(wildcard_to_regex(tokens))
        for offset in self._scan(layer_name, scanner, sections):
            if offset % alignment:
                continue
            hits += 1
            if hits > max_hits:
                stats["truncated"] = True
                continue
            try:
                window = layer.read(offset, length)
            except exceptions.InvalidAddressException:
                continue
            key = bytes(window[key_offset:key_offset + key_length])
            candidate = candidates.setdefault(key, Candidate(key))
            candidate.add_site(offset + key_offset, offset, static_ratio, "anchor")
        stats["hits"] = stats.get("hits", 0) + hits

    def _entropy_locator(self, layer_name, is_slice, sections, params, candidates, stats):
        key_length = int(RECIPE["decoder"]["key_length"])
        step = params.get("step")
        if step is None:
            step = 1 if is_slice else 8
        scanner = EntropyScanner(
            window=int(params.get("window", key_length)),
            threshold=float(params.get("threshold", 4.5)),
            step=int(step),
            block=int(params.get("block", 16)),
            block_min_distinct=int(params.get("block_min_distinct", 12)),
            max_candidates=self._entropy_cap(layer_name, sections, params))
        hits = 0
        try:
            for offset, window in self._scan(layer_name, scanner, sections):
                hits += 1
                key = bytes(window[:key_length])
                candidate = candidates.setdefault(key, Candidate(key))
                candidate.add_site(offset, offset, 0.0, "entropy")
        except EntropyCapReached:
            pass
        stats["hits"] = stats.get("hits", 0) + hits
        stats["examined"] = stats.get("examined", 0) + scanner.examined
        stats["cap"] = scanner.max_candidates
        stats["step"] = scanner.step
        stats["coverage"] = self._coverage(layer_name, sections, scanner.stopped_at)
        stats["truncated"] = stats.get("truncated", False) or scanner.truncated
        if scanner.truncated:
            vollog.warning(
                "entropy locator hit its cap of %d candidates on %s and covered only "
                "%.1f%% of the layer (up to %#x); keys above that address were NOT "
                "searched. Raise max_candidates / step in the recipe, or use --pid.",
                scanner.max_candidates, layer_name, 100.0 * stats["coverage"],
                scanner.stopped_at or 0)

    def _spans(self, layer_name, sections):
        if sections:
            return sections
        layer = self.context.layers[layer_name]
        return [(layer.minimum_address, layer.maximum_address - layer.minimum_address + 1)]

    def _entropy_cap(self, layer_name, sections, params):
        """The recipe cap, scaled up with the bytes to scan (a VIRTUAL layer
        without sections is not scaled: its address range is mostly unmapped)."""
        base = int(params.get("max_candidates", 500000))
        layer = self.context.layers[layer_name]
        if not sections and "memory_layer" in layer.config:
            return base
        size = sum(length for _start, length in self._spans(layer_name, sections))
        return max(base, min(ENTROPY_MAX_SCALED_CAP, size // ENTROPY_BYTES_PER_CANDIDATE))

    def _coverage(self, layer_name, sections, stopped_at):
        """Fraction of the scanned span below ``stopped_at`` (1.0 when not truncated)."""
        if stopped_at is None:
            return 1.0
        spans = self._spans(layer_name, sections)
        total = sum(length for _start, length in spans)
        done = sum(max(0, min(length, stopped_at - start)) for start, length in spans)
        return round(done / float(total), 4) if total > 0 else 0.0

    # ------------------------------------------------------------------ oracle

    def _sample_bytes(self, module):
        """``(sample_blob, source)``; raises ValueError with a readable reason."""
        override = self.config.get("oracle_sample", None)
        spec = RECIPE.get("oracle") or {}
        if override:
            path = override
            if path.startswith("file:"):
                path = parse.unquote(parse.urlparse(path).path)
            if os.path.isdir(path):
                reader = getattr(module, "sample_from_vault", None)
                if reader is None:
                    raise ValueError("oracle %s cannot read a directory" % module.KIND)
                check_sample_dir(path)
                return reader(path), "dir:" + path
            with open(path, "rb") as handle:
                raw = handle.read()
            try:
                module.build_oracle(self._oracle_params(), raw)
                return raw, "sample:" + path
            except ValueError:
                return module.make_sample(raw), "file:" + path
        sample = spec.get("sample") or {}
        if sample.get("inline_b64"):
            blob = base64.b64decode(sample["inline_b64"])
            if sample.get("sha256") and hashlib.sha256(blob).hexdigest() != sample["sha256"]:
                raise ValueError("embedded oracle sample fails its sha256 check")
            return blob, "embedded"
        raise ValueError("no oracle sample (pass --oracle-sample)")

    def _oracle_params(self):
        params = dict((RECIPE.get("oracle") or {}).get("params") or {})
        params.update(parse_oracle_params(self.config.get("oracle_param", None)))
        return params

    def _load_oracle(self):
        """``(oracle, kind, error)``: exactly one of oracle / error is set."""
        spec = RECIPE.get("oracle")
        if not spec:
            return None, None, None
        kind = spec["kind"]
        try:
            module = load_inlined(kind, MEMDIVER_INLINED_SOURCES)
            blob, source = self._sample_bytes(module)
            oracle = module.build_oracle(self._oracle_params(), blob)
            self._module_cost_us = getattr(module, "COST_US", None)
        except Exception as exc:  # any failure is reported per row, never fatal
            vollog.warning("oracle %s unavailable: %s", kind, exc)
            return None, kind, "%s" % (exc,)
        vollog.info("oracle %s armed from %s", kind, source)
        self._log_crypto_backend(kind, oracle)
        return oracle, kind, None

    @staticmethod
    def _log_crypto_backend(kind, oracle):
        """Say once which crypto backend proves keys; pure Python works everywhere but slowly."""
        backend = getattr(oracle, "backend", None)
        if backend == PURE_PYTHON_BACKEND:
            vollog.warning("oracle %s proves keys with pure-Python crypto (correct but slower); "
                           "pip install cryptography or pycryptodome to speed it up", kind)
        elif backend:
            vollog.info("oracle %s crypto backend: %s", kind, backend)
        elif getattr(oracle, "backend_error", None):
            vollog.warning("oracle %s has no crypto backend: %s", kind, oracle.backend_error)

    def _judge(self, candidates, oracle, kind, error, layer_name=None):
        """Filter, order, then verify the undecided candidates within the oracle budget."""
        proven_before = any(c.is_proven for c in candidates.values())
        pending = self._filter_candidates(candidates, oracle, kind, error)
        if not pending:
            return
        pending.sort(key=self._verify_order_key())
        self._log_estimate(kind, oracle, len(pending))
        ctx = self._oracle_ctx(pending, layer_name)
        self._verify_in_order(pending, oracle, kind, ctx, proven_before)

    def _filter_candidates(self, candidates, oracle, kind, error):
        """Decide the cheap cases in place; return the candidates the oracle must verify."""
        lengths = getattr(oracle, "candidate_lengths", None)
        prefilter = getattr(oracle, "prefilter", None)
        pending = []
        for candidate in candidates.values():
            if candidate.proven != "unverified":
                continue
            if candidate.entropy < PREFILTER_MIN_ENTROPY:
                candidate.proven = "rejected"
                candidate.detail = "prefilter: entropy %.2f < %.1f" % (
                    candidate.entropy, PREFILTER_MIN_ENTROPY)
                continue
            if oracle is None:
                if error:
                    candidate.proven = "error:oracle"
                    candidate.detail = error[:160]
                continue
            if lengths and len(candidate.key) not in lengths:
                candidate.proven = "error:length"
                candidate.detail = "oracle %s takes %s-byte keys" % (kind, list(lengths))
                continue
            reason = self._prefilter_reason(prefilter, candidate.key)
            if reason:
                candidate.proven = "rejected"
                candidate.detail = ("prefilter: %s" % (reason,))[:160]
                continue
            pending.append(candidate)
        return pending

    @staticmethod
    def _prefilter_reason(prefilter, key):
        """The oracle's cheap rejection reason, or None (a failing prefilter rejects nothing)."""
        if prefilter is None:
            return None
        try:
            return prefilter(key)
        except Exception as exc:  # never let a broken prefilter turn into "rejected"
            vollog.debug("oracle prefilter failed: %s", exc)
            return None

    @staticmethod
    def _verify_order_key():
        """Anchor candidates first, then by the recipe position of the first locator,
        then by entropy (highest first), then by offset (deterministic)."""
        positions = {}
        for position, locator in enumerate(RECIPE["locators"]):
            positions.setdefault(locator_name(locator), position)
        unknown = len(RECIPE["locators"])
        return lambda c: ("anchor" not in c.locators,
                          min([positions.get(n, unknown) for n in c.locators] or [unknown]),
                          -c.entropy, c.sites[0][0] if c.sites else 0)

    def _cost_us(self, oracle):
        """Estimated microseconds per verify (None if unknown), x20 on pure Python."""
        cost = getattr(oracle, "cost_us", None)
        if cost is None:
            cost = getattr(self, "_module_cost_us", None)
        try:
            cost = float(cost)
        except (TypeError, ValueError):
            return None
        if getattr(oracle, "backend", None) == PURE_PYTHON_BACKEND:
            cost *= PURE_PYTHON_COST_FACTOR
        return cost

    def _estimate_s(self, oracle, count):
        cost = self._cost_us(oracle)
        return None if cost is None else count * cost / 1e6

    def _log_estimate(self, kind, oracle, count):
        """ONE line per pass: what verifying ``count`` candidates should cost."""
        cost, estimate = self._cost_us(oracle), self._estimate_s(oracle, count)
        left = getattr(self, "_budget_left", None)
        over = estimate is not None and left is not None and estimate > left
        (vollog.warning if over else vollog.info)(
            "oracle %s: %d candidate(s) to verify, est %s (%d x %s us); budget left %s",
            kind, count, "?" if estimate is None else "%.2f s" % estimate, count,
            "?" if cost is None else "%g" % cost,
            "unlimited" if left is None else "%.2f s" % left)

    def _oracle_ctx(self, pending, layer_name):
        """The pass ctx: the recipe's static ctx under found / layer / read."""
        ctx = dict((RECIPE.get("oracle") or {}).get("ctx") or {})
        ctx["found"] = tuple(c.key for c in pending)
        ctx["layer"] = layer_name
        ctx["read"] = self._layer_reader(layer_name)
        return ctx

    def _layer_reader(self, layer_name):
        if layer_name is None:
            return None
        layer = self.context.layers[layer_name]

        def read(offset, length):
            """Bytes of the scanned layer; unreadable bytes read as zeros (pad)."""
            try:
                return bytes(layer.read(offset, length, pad=True))
            except exceptions.InvalidAddressException:
                return bytes(length)
        return read

    def _verify_in_order(self, pending, oracle, kind, ctx, proven_before):
        unique = bool(getattr(oracle, "unique", False))
        left = getattr(self, "_budget_left", None)
        started = time.monotonic()
        deadline = None if left is None else started + left
        for index, candidate in enumerate(pending):
            if unique and proven_before:
                candidate.detail = "skipped: key already proven"
                continue
            if deadline is not None and time.monotonic() >= deadline:
                self._mark_over_budget(pending[index:], oracle)
                break
            self._verify_one(candidate, oracle, kind, ctx)
            proven_before = proven_before or candidate.is_proven
        if left is not None:
            self._budget_left = max(0.0, left - (time.monotonic() - started))

    def _mark_over_budget(self, leftovers, oracle):
        """Budget exhausted: the rest stay ``unverified`` (never ``rejected``)."""
        estimate = self._estimate_s(oracle, len(leftovers))
        detail = "budget: %d not verified (est %s s; raise --oracle-budget)" % (
            len(leftovers), "?" if estimate is None else "%.2f" % estimate)
        for candidate in leftovers:
            candidate.detail = detail
        self._budget_skipped = getattr(self, "_budget_skipped", 0) + len(leftovers)
        vollog.warning("oracle budget exhausted: %s", detail)

    @staticmethod
    def _verify_one(candidate, oracle, kind, ctx):
        offset = candidate.sites[0][0] if candidate.sites else None
        verdict = oracle.verify(candidate.key, dict(ctx, offset=offset,
                                                    locators=tuple(candidate.locators)))
        status = verdict.get("status") if isinstance(verdict, dict) else None
        candidate.detail = str(verdict.get("detail", "")) if isinstance(verdict, dict) else ""
        if status == "proven":
            candidate.proven = "oracle:%s" % kind
        elif status == "rejected":
            candidate.proven = "rejected"
        else:
            candidate.proven = error_code(candidate.detail)

    # ---------------------------------------------------------------- pipeline

    def _collect(self):
        """Run the locators over every target and judge the candidates."""
        candidates, stats = {}, {"layers": [], "locators": {}}
        oracle, kind, error = self._load_oracle()
        exhaustive = bool(self.config.get("exhaustive", False))
        self._start_budget()
        started = time.time()
        for layer_name, is_slice, sections in self._scan_targets():
            stats["layers"].append(layer_name)
            for position, locator in enumerate(RECIPE["locators"]):
                lstats = stats["locators"].setdefault(
                    "%d:%s" % (position, locator["kind"]), {"hits": 0})
                if locator["kind"] == "anchor_regex":
                    self._anchor_locator(layer_name, sections, locator["params"], candidates,
                                         lstats)
                elif locator["kind"] == "entropy":
                    mode = locator["params"].get("mode", "fallback")
                    reason = self._entropy_skip_reason(candidates, oracle)
                    if reason and not exhaustive and mode != "always":
                        lstats["skipped"] = reason
                        continue
                    self._entropy_locator(layer_name, is_slice, sections, locator["params"],
                                          candidates, lstats)
                else:
                    vollog.warning("locator %s is not implemented in this plugin",
                                   locator["kind"])
                    continue
                lstats["unique_candidates"] = sum(
                    1 for c in candidates.values() if locator_name(locator) in c.locators)
                self._judge(candidates, oracle, kind, error, layer_name)
                if locator["kind"] == "anchor_regex" and self._anchor_all_rejected(candidates):
                    lstats["all_rejected"] = True
                    vollog.warning(
                        "anchor matched %d candidate(s) but the oracle rejected every one: "
                        "is --oracle-sample from THIS capture's vault? (entropy fallback "
                        "skipped; pass --exhaustive to run it anyway)",
                        lstats["unique_candidates"])
                vollog.info("locator %s on %s: %s", locator["kind"], layer_name, lstats)
            self._tag_scope(candidates, self._scope_of(layer_name))
        stats["elapsed_s"] = round(time.time() - started, 3)
        stats["unique_candidates"] = len(candidates)
        stats["proven"] = sum(1 for c in candidates.values() if c.is_proven)
        stats["oracle"] = {"kind": kind, "armed": oracle is not None, "error": error,
                           "budget_s": self._budget_s, "not_verified": self._budget_skipped}
        return candidates, stats

    def _start_budget(self):
        """Arm the per-run oracle budget (seconds of verification, not of scanning)."""
        try:
            self._budget_s = parse_oracle_budget(self.config.get("oracle_budget", None))
        except ValueError as exc:
            vollog.warning("%s; using the default %g s", exc, DEFAULT_ORACLE_BUDGET_S)
            self._budget_s = DEFAULT_ORACLE_BUDGET_S
        self._budget_left = self._budget_s
        self._budget_skipped = 0

    @staticmethod
    def _anchor_all_rejected(candidates):
        anchored = [c for c in candidates.values() if "anchor" in c.locators]
        return bool(anchored) and all(
            c.proven == "rejected" and not c.detail.startswith("prefilter")
            for c in anchored)

    @classmethod
    def _entropy_skip_reason(cls, candidates, oracle):
        """Why the (fallback) entropy locator need not run, or ``None``."""
        if oracle is None:
            return "no oracle to filter candidates"
        if any(c.is_proven for c in candidates.values()):
            return "a key is already proven"
        if candidates and all(c.proven.startswith("error") for c in candidates.values()):
            return "the oracle could not decide any anchor candidate"
        if cls._anchor_all_rejected(candidates):
            return "the oracle rejected every anchor candidate (sample from another vault?)"
        return None

    def _rows(self, candidates):
        show_all = bool(self.config.get("show_unverified", False))
        ordered = sorted(candidates.values(),
                         key=lambda c: (not c.is_proven, "anchor" not in c.locators,
                                        c.sites[0][0] if c.sites else 0))
        proven_any = any(c.is_proven for c in ordered)
        rows, unproven = [], 0
        for candidate in ordered:
            if not candidate.is_proven:
                if not show_all and (proven_any or unproven >= UNPROVEN_PREVIEW_ROWS):
                    continue
                unproven += 1
            for key_offset, pattern_offset, static_ratio, locator in candidate.sites:
                if len(rows) >= MAX_ROWS:
                    return rows
                detail = "via %s" % "+".join(candidate.locators)
                if candidate.detail:
                    detail += "; " + candidate.detail
                rows.append((key_offset, candidate.key.hex(),
                             round(shannon_entropy(candidate.key), 4), len(candidate.key),
                             pattern_offset, static_ratio, candidate.proven, detail,
                             candidate.site_scopes.get(key_offset, "physical")))
        return rows

    def _export(self, rows, stats):
        name = self.config.get("export_path", None) or "%s.json" % PATTERN_NAME
        report = {"plugin": PATTERN_NAME, "recipe": RECIPE.get("name"), "stats": stats,
                  "rows": [{"key_offset": r[0], "key_hex": r[1], "key_entropy": r[2],
                            "key_length": r[3], "pattern_offset": r[4],
                            "static_ratio": r[5], "proven": r[6], "detail": r[7],
                            "scope": r[8]}
                           for r in rows]}
        with self.open(name) as handle:
            handle.write(json.dumps(report, indent=1, sort_keys=True).encode("utf-8"))

    def _generator(self):
        candidates, stats = self._collect()
        rows = self._rows(candidates)
        vollog.info("%s: %d unique candidates, %d proven, %d rows, %.2fs", PATTERN_NAME,
                    stats["unique_candidates"], stats["proven"], len(rows), stats["elapsed_s"])
        if self.config.get("export", False):
            self._export(rows, stats)
        for row in rows:
            yield (0, (format_hints.Hex(row[0]), row[1], row[2], row[3],
                       format_hints.Hex(row[4]) if row[4] is not None
                       else renderers.NotApplicableValue(),
                       row[5], row[6], row[7], row[8]))

    def run(self):
        return renderers.TreeGrid(_COLUMNS, self._generator())


def locator_name(locator):
    return "anchor" if locator["kind"] == "anchor_regex" else locator["kind"]


# <memdiver inlined oracle bundle: pinned separately>
MEMDIVER_INLINED_SOURCES = ''

