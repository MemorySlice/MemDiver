{
  "name": "memdiver-e2e",
  "version": "0.0.0",
  "private": true,
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "typescript": "^5.5.0",
    "get-port": "^7.1.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test workspace-smoke",
    "test:format": "playwright test format",
    "test:strings": "playwright test strings",
    "test:a11y": "playwright test specs/a11y-",
    "test:a11y:seed": "A11Y_SEED=1 playwright test specs/a11y-",
    "test:no-dataset": "playwright test --grep-invert @requires-dataset",
    "test:dataset": "playwright test --grep @requires-dataset",
    "install-browsers": "playwright install chromium"
  }
}
