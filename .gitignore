__pycache__/
*.pyc
*.pyo
.pytest_cache/
.hypothesis/
*.egg-info/
dist/
build/
*.png

# npm workspaces: one hoisted install lives at the repo root. frontend/ and
# tests/e2e/ no longer get their own tree from npm, but vite still writes
# frontend/node_modules/.vite (its cacheDir) and tsc writes
# frontend/node_modules/.tmp/*.tsbuildinfo -- so this must match at any depth.
node_modules/
.venv/
env/
*.log
*.json
# ...but the TS project configs are real source and must be tracked. The blanket
# *.json above exists to keep generated artifacts out; these are hand-written.
!frontend/tsconfig*.json
!tsconfig*.json
# Same story for the i18n locale files: each one IS a namespace (i18n/index.ts
# globs this directory and derives the namespace from the basename), so a
# missing file is a screen full of raw `ns.key` strings. The 17 that predate the
# blanket rule stayed tracked because *.json cannot un-track a tracked file --
# candidates.json was added later and was silently never committed, which is
# exactly the failure this negation exists to stop happening again.
!frontend/src/i18n/locales/*/*.json
# Same story for the npm manifests now that the repo is an npm workspace root.
# Anchored with a leading `/` so each names exactly one file: a bare
# `!package.json` would un-ignore that basename at EVERY level of the tree.
!/package.json
!/package-lock.json
!/frontend/package.json
!/tests/e2e/package.json
# And the shared needle-parser vectors: core/needle.py and
# frontend/src/utils/needle.ts are the same contract written in two languages,
# and this table is the ONLY thing that fails when they drift. Untracked, it
# would pass every local test and then be missing for everyone else -- the
# candidates.json failure above, repeated.
!/tests/fixtures/needle_vectors.json
# The scripted agent-chat demo (hand-written, read by the e2e spec): ignored, it would
# pass locally and be a missing file in CI.
!/tests/e2e/fixtures/agent_chat/*.json
# Same for the region-name classification vectors, shared byte-identical with
# memslicer's tests/data/region_name_vectors.json: untracked, five test modules
# pass locally and are a FileNotFoundError at collection in CI.
!/tests/fixtures/region_name_vectors.json
# Generated-once, committed test fixtures (each dir has a generate.py whose
# docstring says the output is committed). Tests open these directly, so an
# ignored copy passes locally and is a FileNotFoundError in CI.
!/tests/e2e/fixtures/pcap/manifest.json
!/tests/e2e/fixtures/keylog/expected.json
!/tests/e2e/fixtures/verify_key/verify-fixture.json
!/tests/e2e/fixtures/gcore_planted/planted.json
!/tests/e2e/fixtures/glibc_heap_msl/expected.json
!/tests/fixtures/tshark/secrets.json
.DS_Store
.dSYM/
*.dSYM/

# Compiled AES sample binary — built on demand, never committed.
tests/fixtures/aes_sample
tests/fixtures/aes_sample.dSYM/
tests/fixtures/dataset/
# Synthetic realistic captures (ELF cores, boringssl TLS trees) + fixture-root
# region dumps (gdb_raw/lldb_raw), regenerated at pytest_configure — see
# tests/fixtures/synth_dataset.py.
tests/fixtures/synthetic_dataset/
tests/fixtures/datasets/

# E2E test artifacts (screenshots, ad-hoc outputs).
tests/artifacts/
*.dump
*.csv

# Sphinx documentation build output.
docs/_build/
docs/api/_autosummary/
docs/screenshots/_tempdata/

# local/misc stuff
docs/_static/screenshots/.backup_20260422T221132/
docs/_static/screenshots/.triptych_parts/
.claude/
docs/issue-drafts/
docs/dev/

.coverage

# The e2e backend's own MemDiver home (XDG_DATA_HOME in tests/e2e/playwright.config.ts):
# project.duckdb, the session store and the preferences file the suite resets.
/tests/e2e/.memdiver-home/

# Playwright MCP browser sessions drop screenshots and snapshot .yml here.
# Tooling output from an interactive browser check, never part of the repo.
.playwright-mcp/
